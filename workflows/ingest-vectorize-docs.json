    {
      "parameters": {
        "functionCode": "// Analyze duplicate check results\nconst checkResult = $input.item.json;\nconst existingPoints = checkResult.result?.points || [];\nconst documentHash = $('Generate Document Hash').item.json;\n\nif (existingPoints.length > 0) {\n  // Document exists - check if content changed\n  const existingContentHash = existingPoints[0].payload?.content_hash;\n  const newContentHash = documentHash.content_hash;\n  \n  const pointIds = existingPoints.map(p => p.id);\n  \n  return {\n    ...documentHash,\n    duplicate_found: true,\n    content_changed: existingContentHash !== newContentHash,\n    existing_points: pointIds,\n    existing_count: existingPoints.length,\n    action: existingContentHash !== newContentHash ? 'update' : 'skip'\n  };\n} else {\n  // New document\n  return {\n    ...documentHash,\n    duplicate_found: false,\n    content_changed: true,\n    existing_points: [],\n    existing_count: 0,\n    action: 'insert'\n  };\n}"
      },
