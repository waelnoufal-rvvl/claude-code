    {
      "parameters": {
        "functionCode": "// Generate document hash for duplicate detection\nconst crypto = require('crypto');\n\nconst documentContent = $input.item.json.document_content || $input.item.json.body?.document_content || '';\nconst filename = $input.item.json.filename || $input.item.json.body?.filename || 'unknown';\nconst collection = $input.item.json.collection || $input.item.json.body?.collection || 'documents';\n\n// Generate SHA-256 hash of filename for consistent ID\nconst fileHash = crypto.createHash('sha256').update(filename).digest('hex');\n\n// Generate content hash for change detection\nconst contentHash = crypto.createHash('sha256').update(documentContent).digest('hex');\n\nreturn {\n  filename: filename,\n  document_content: documentContent,\n  collection: collection,\n  file_hash: fileHash,\n  content_hash: contentHash,\n  metadata: {\n    original_filename: filename,\n    upload_timestamp: new Date().toISOString(),\n    file_size: documentContent.length\n  }\n};"
      },
