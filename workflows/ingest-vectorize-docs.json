    {
      "parameters": {
        "functionCode": "// Chunk document into smaller pieces for embedding\nconst analysisData = $('Analyze Duplicate Status').item.json;\nconst documentContent = analysisData.document_content;\nconst filename = analysisData.filename;\nconst collection = analysisData.collection;\nconst fileHash = analysisData.file_hash;\nconst contentHash = analysisData.content_hash;\n\n// Simple chunking strategy: split by paragraphs with max size\nconst MAX_CHUNK_SIZE = 1000; // characters\nconst paragraphs = documentContent.split(/\\n\\n+/);\nconst chunks = [];\n\nlet currentChunk = '';\nlet chunkIndex = 0;\n\nfor (const paragraph of paragraphs) {\n  const trimmed = paragraph.trim();\n  if (!trimmed) continue;\n  \n  if (currentChunk.length + trimmed.length > MAX_CHUNK_SIZE && currentChunk.length > 0) {\n    // Save current chunk and start new one\n    chunks.push({\n      content: currentChunk.trim(),\n      chunk_index: chunkIndex,\n      total_chunks: 0 // Will update after\n    });\n    chunkIndex++;\n    currentChunk = trimmed;\n  } else {\n    currentChunk += (currentChunk ? '\\n\\n' : '') + trimmed;\n  }\n}\n\n// Add last chunk\nif (currentChunk.trim()) {\n  chunks.push({\n    content: currentChunk.trim(),\n    chunk_index: chunkIndex,\n    total_chunks: 0\n  });\n}\n\n// Update total_chunks\nconst totalChunks = chunks.length;\nchunks.forEach(chunk => {\n  chunk.total_chunks = totalChunks;\n  chunk.filename = filename;\n  chunk.collection = collection;\n  chunk.file_hash = fileHash;\n  chunk.content_hash = contentHash;\n  chunk.metadata = analysisData.metadata;\n});\n\nreturn {\n  chunks: chunks,\n  metadata: {\n    ...analysisData.metadata,\n    total_chunks: totalChunks,\n    file_hash: fileHash,\n    content_hash: contentHash\n  }\n};"
      },
