        "functionCode": "// Centralized error logger\nconst errorData = $input.item.json;\n\nconst logEntry = {\n  level: 'ERROR',\n  timestamp: errorData.timestamp || new Date().toISOString(),\n  error_type: errorData.error_type || 'unknown_error',\n  error_message: errorData.error_message || 'An error occurred',\n  workflow: 'Ingest & Vectorize Documents',\n  execution_id: $execution.id\n};\n\n// Log to console (visible in n8n logs)\nconsole.error('[ERROR LOG]', JSON.stringify(logEntry, null, 2));\n\n// Return formatted log entry\nreturn logEntry;"
