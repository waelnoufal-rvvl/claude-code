      "name": "Prepare Validation Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [650, 450]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "url": "https://api.openai.com/v1/embeddings",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"text-embedding-ada-002\",\n  \"input\": \"{{ $json.query || $json.body?.query }}\"\n}",
        "options": {
          "retry": {
            "retry": {
              "maxRetries": 3,
              "retryInterval": 1000
            }
          },
          "timeout": 30000
        }
      },
      "id": "generate-query-embedding",
      "name": "Generate Query Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300],
      "credentials": {
        "openAiApi": {
          "id": "ybKWjgaznJsUQAHd",
          "name": "OpenAi account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error-type",
              "name": "error_type",
              "value": "embedding_error",
              "type": "string"
            },
            {
              "id": "error-message",
              "name": "error_message",
              "value": "={{ $json.error || 'Failed to generate query embedding' }}",
              "type": "string"
