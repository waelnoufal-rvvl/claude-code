              "value": "validation_error",
              "type": "string"
            },
            {
              "id": "error-message",
              "name": "error_message",
              "value": "={{ !$env.QDRANT_URL ? 'Missing QDRANT_URL environment variable' : 'Missing query parameter' }}",
              "type": "string"
