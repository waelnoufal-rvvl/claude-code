      "parameters": {
        "functionCode": "// Extract Mistral response from input\nconst mistralResponse = $input.item.json.mistral_response || $input.item.json.body?.mistral_response || '';\n\n// Initialize arrays for different content types\nconst textChunks = [];\nconst tables = [];\nconst figures = [];\n\n// Regex patterns for content detection\nconst tableRegex = /\\|(.+)\\|[\\r\\n]+\\|[-:\\s|]+\\|[\\r\\n]+((?:\\|.+\\|[\\r\\n]+)+)/g;\nconst htmlTableRegex = /<table[\\s\\S]*?<\\/table>/gi;\nconst imageRegex = /!\\[([^\\]]*)\\]\\(([^)]+)\\)/g;\nconst htmlImageRegex = /<img[^>]+src=[\"']([^\"']+)[\"'][^>]*>/gi;\n\n// Extract tables (markdown format)\nlet tableMatch;\nwhile ((tableMatch = tableRegex.exec(mistralResponse)) !== null) {\n  tables.push({\n    content: tableMatch[0],\n    type: 'markdown',\n    index: tableMatch.index\n  });\n}\n\n// Extract tables (HTML format)\nlet htmlTableMatch;\nwhile ((htmlTableMatch = htmlTableRegex.exec(mistralResponse)) !== null) {\n  tables.push({\n    content: htmlTableMatch[0],\n    type: 'html',\n    index: htmlTableMatch.index\n  });\n}\n\n// Extract figures (markdown images)\nlet imageMatch;\nwhile ((imageMatch = imageRegex.exec(mistralResponse)) !== null) {\n  figures.push({\n    alt_text: imageMatch[1],\n    url: imageMatch[2],\n    type: 'markdown',\n    index: imageMatch.index\n  });\n}\n\n// Extract figures (HTML images)\nlet htmlImageMatch;\nwhile ((htmlImageMatch = htmlImageRegex.exec(mistralResponse)) !== null) {\n  figures.push({\n    url: htmlImageMatch[1],\n    type: 'html',\n    index: htmlImageMatch.index\n  });\n}\n\n// Remove tables and figures from response to get text only\nlet textOnly = mistralResponse;\n\n// Sort removals by index (descending) to avoid offset issues\nconst removals = [\n  ...tables.map(t => ({ index: t.index, length: t.content.length })),\n  ...figures.map(f => {\n    if (f.type === 'markdown') {\n      return { index: f.index, length: `![${f.alt_text}](${f.url})`.length };\n    } else {\n      const match = mistralResponse.substring(f.index).match(/<img[^>]+>/);\n      return { index: f.index, length: match ? match[0].length : 0 };\n    }\n  })\n].sort((a, b) => b.index - a.index);\n\nfor (const removal of removals) {\n  textOnly = textOnly.substring(0, removal.index) + textOnly.substring(removal.index + removal.length);\n}\n\n// Split text into paragraphs/chunks\nconst paragraphs = textOnly\n  .split(/\\n\\n+/)\n  .map(p => p.trim())\n  .filter(p => p.length > 0);\n\nparagraphs.forEach((paragraph, idx) => {\n  textChunks.push({\n    content: paragraph,\n    chunk_index: idx,\n    type: 'text'\n  });\n});\n\n// Return separated content\nreturn {\n  text: textChunks,\n  tables: tables.map((t, idx) => ({ ...t, table_index: idx })),\n  figures: figures.map((f, idx) => ({ ...f, figure_index: idx })),\n  metadata: {\n    total_text_chunks: textChunks.length,\n    total_tables: tables.length,\n    total_figures: figures.length,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
